  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('fs').copyFileSync('index.dev.html','index.html')\"",
    "dev": "vite",
    "prebuild": "node -e \"require('fs').copyFileSync('index.dev.html','index.html')\"",
    "build": "tsc -b && vite build && node scripts/spa-fallback.mjs",
    "lint": "eslint .",
